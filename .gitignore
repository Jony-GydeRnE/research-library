node_modules/
.env
.DS_Store
uploads/
*.log
*.png
*.jpg
*.jpeg
.tmp.driveupload/

# Bulk PDF library — Jony's local-only book stash, ~1000 advanced
# math/physics/nuclear/fusion books. Never commit. Drop PDFs anywhere
# under pdfs/ at any folder depth and they stay local.
pdfs/

# Root-level PDFs — catches stray uploads dropped at project root so
# they can't accidentally be committed. Curated PDFs that DO belong
# in git (e.g. Rodina notes) live under reports/ and are unaffected.
/*.pdf

# Debug screenshots — explicitly allowed so other LLMs working
# in this repo can see UI state across sessions. The bulky
# archive subfolder stays ignored.
!reports/debug-pix/
!reports/debug-pix/*.png
!reports/debug-pix/*.jpg
!reports/debug-pix/*.jpeg
reports/debug-pix/older pics/
reports/debug-pix/34902/
reports/debug-pix/34904/
reports/debug-pix/34906/
reports/debug-pix/34908/
