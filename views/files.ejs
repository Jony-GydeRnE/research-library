<%- include('partials/layout-start') %>

<div class="files-page">
  <div class="files-topbar">
    <h1 class="files-title">All Files</h1>
    <div class="files-actions">
      <a href="/upload" class="btn btn-primary">Upload</a>
    </div>
  </div>

  <div class="files-tabs" role="tablist">
    <a href="/files" class="files-tab <%= tab === 'books' ? 'active' : '' %>" role="tab">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <span>All Books</span>
      <% if (tab === 'books' && typeof books !== 'undefined') { %>
        <span class="files-tab-count"><%= books.length %></span>
      <% } %>
    </a>
    <a href="/files/notes" class="files-tab <%= tab === 'notes' ? 'active' : '' %>" role="tab">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      <span>All Notes</span>
      <% if (tab === 'notes' && typeof notebooks !== 'undefined') { %>
        <span class="files-tab-count"><%= notebooks.length %></span>
      <% } %>
    </a>
  </div>

  <% if (tab === 'books') { %>
    <% if (!books || books.length === 0) { %>
      <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <h2>No books yet</h2>
        <p>Upload a PDF to get started.</p>
        <a href="/upload" class="btn btn-primary">Upload a PDF</a>
      </div>
    <% } else { %>
      <div class="book-grid files-grid">
        <% books.forEach(function(book) { %>
          <div class="book-card-wrap" data-book-id="<%= book._id %>">
            <a href="/reader/<%= book._id %>" class="book-card">
              <div class="book-cover">
                <% if (book.coverUrl) { %>
                  <img src="<%= book.coverUrl %>" alt="<%= book.title %>" class="cover-image">
                <% } else { %>
                  <div class="cover-placeholder">
                    <div class="cover-spine"></div>
                    <div class="cover-front">
                      <span class="cover-title"><%= book.title || 'Untitled' %></span>
                      <% if (book.author) { %>
                        <span class="cover-author"><%= book.author %></span>
                      <% } %>
                    </div>
                  </div>
                <% } %>
                <% if (book.status === 'processing') { %>
                  <div class="processing-overlay">
                    <div class="processing-spinner"></div>
                    <span class="processing-pct"><%= book.visionProgress || (book.processingProgress + '%') %></span>
                  </div>
                <% } %>
              </div>
              <div class="book-info">
                <h3 class="book-title"><%= book.title || 'Untitled' %></h3>
                <% if (book.author) { %>
                  <p class="book-author"><%= book.author %></p>
                <% } %>
                <div class="book-meta-row">
                  <% if (book.pageCount) { %>
                    <span class="book-pages"><%= book.pageCount %> pages</span>
                  <% } %>
                  <% if (book.noteCount && book.noteCount > 0) { %>
                    <span class="book-notes"><%= book.noteCount %> note<%= book.noteCount === 1 ? '' : 's' %></span>
                  <% } %>
                </div>
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    <% } %>
  <% } else if (tab === 'notes') { %>
    <% if (!notebooks || notebooks.length === 0) { %>
      <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <h2>No notebooks yet</h2>
        <p>Notes you write while reading will collect here as notebooks, one per book.</p>
      </div>
    <% } else { %>
      <div class="notebook-grid">
        <% notebooks.forEach(function(book) { %>
          <a href="/files/notebook/<%= book._id %>" class="notebook-card">
            <div class="notebook-card-cover">
              <% if (book.coverUrl) { %>
                <img src="<%= book.coverUrl %>" alt="<%= book.title %>">
              <% } else { %>
                <div class="notebook-card-placeholder">
                  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                </div>
              <% } %>
              <div class="notebook-card-count"><%= book.noteCount %></div>
            </div>
            <div class="notebook-card-body">
              <h3 class="notebook-card-title"><%= book.title || 'Untitled' %></h3>
              <% if (book.author) { %>
                <p class="notebook-card-author"><%= book.author %></p>
              <% } %>
              <% if (book.latestNote) { %>
                <p class="notebook-card-latest">Last updated <%= new Date(book.latestNote).toLocaleDateString() %></p>
              <% } %>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  <% } %>
</div>

<%- include('partials/layout-end') %>
