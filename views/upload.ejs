<%- include('partials/layout-start') %>

<div class="collection-page">
  <div class="upload-container" style="max-width:560px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:2rem;">
      <h1>Add to Your Library</h1>
      <p style="color:var(--app-text-muted);font-size:0.9rem;">Upload academic books and papers in PDF format</p>
    </div>

    <div class="drop-zone" id="dropZone">
      <div class="drop-zone-content" id="dropContent">
        <div class="drop-icon" style="color:var(--app-text-muted);margin-bottom:1rem;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </div>
        <p style="font-weight:500;margin-bottom:0.4rem;">Drag and drop your PDF here</p>
        <p style="color:var(--app-text-muted);font-size:0.8rem;margin-bottom:0.75rem;">or</p>
        <label class="btn btn-primary" for="fileInput" style="cursor:pointer;">Browse Files</label>
        <input type="file" id="fileInput" accept=".pdf" hidden>
        <p style="color:var(--app-text-muted);font-size:0.75rem;margin-top:0.75rem;">PDF files up to 200 MB</p>
        <label class="upload-kind-toggle" style="display:flex;align-items:center;justify-content:center;gap:0.5rem;margin-top:1rem;cursor:pointer;font-size:0.85rem;color:var(--app-text);">
          <input type="checkbox" id="isNotesToggle" style="cursor:pointer;width:16px;height:16px;">
          <span>This is a <strong>notes PDF</strong> (handwritten / stylus / whiteboard)</span>
        </label>
        <p id="notesHint" style="display:none;color:var(--app-text-muted);font-size:0.7rem;margin-top:0.4rem;font-style:italic;max-width:380px;margin-left:auto;margin-right:auto;line-height:1.4;">
          Vision will use the handwriting prompt: LaTeX for equations, descriptive blocks for diagrams, [unclear: …] markers for illegible symbols. After upload, use the kebab → "Link to source book" to anchor the notes to one or more papers.
        </p>
      </div>

      <div class="upload-progress" id="uploadProgress" style="display:none;text-align:left;">
        <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem;color:var(--app-text-muted);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <div>
            <div id="fileName" style="font-weight:500;color:var(--app-text);font-size:0.9rem;"></div>
            <div id="fileSize" style="font-size:0.75rem;"></div>
          </div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-bottom:0.4rem;">
          <span id="progressLabel" style="font-size:0.825rem;font-weight:500;">Uploading...</span>
          <span id="progressPct" style="font-size:0.825rem;color:var(--app-text-muted);">0%</span>
        </div>
        <div style="height:5px;background:var(--app-border);border-radius:3px;overflow:hidden;">
          <div id="progressFill" style="height:100%;width:0%;background:var(--app-accent);border-radius:3px;transition:width 0.3s ease;"></div>
        </div>
        <p id="progressDetail" style="margin-top:0.5rem;font-size:0.75rem;color:var(--app-text-muted);"></p>
      </div>

      <div id="uploadSuccess" style="display:none;text-align:center;">
        <div style="color:#2d7b5a;margin-bottom:0.75rem;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <h2 id="successTitle" style="font-size:1.1rem;margin-bottom:0.3rem;color:var(--app-text-bright);">Done</h2>
        <p id="successDetail" style="color:var(--app-text-muted);font-size:0.85rem;margin-bottom:1rem;"></p>
        <div style="display:flex;gap:0.5rem;justify-content:center;">
          <a class="btn btn-primary" id="openBookBtn" href="/collections">Open in Reader</a>
          <button class="btn btn-secondary" id="uploadAnotherBtn">Upload Another</button>
        </div>
      </div>

      <div id="uploadError" style="display:none;text-align:center;">
        <div style="color:#a33;margin-bottom:0.75rem;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
        <h2 style="font-size:1.1rem;margin-bottom:0.3rem;color:var(--app-text-bright);">Upload Failed</h2>
        <p id="errorDetail" style="color:var(--app-text-muted);font-size:0.85rem;margin-bottom:1rem;"></p>
        <button class="btn btn-secondary" id="retryBtn">Try Again</button>
      </div>
    </div>
  </div>
</div>

<script src="/js/upload.js"></script>

<%- include('partials/layout-end') %>
