<!DOCTYPE html>
<html lang="en" data-theme="space">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Gyde Research Library</title>
  <!-- Theme loader: runs before CSS so there is no flash of the default
       theme when the user has picked a different one. Must be inline so
       it blocks paint. Default is "space". -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem('gyde-theme') || 'space';
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="app-body">
  <%- include('sidebar') %>
  <div class="app-main">
