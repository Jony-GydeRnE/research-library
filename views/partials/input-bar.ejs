<div class="input-bar" id="inputBar">
  <div class="input-bar-inner">
    <button class="input-attach-btn" disabled title="Attach files (coming soon)">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
    </button>
    <input type="text" class="input-field" id="inputField" placeholder="Ask about your research..." autocomplete="off">
    <button class="input-send-btn" id="inputSendBtn" title="Send">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
    </button>
  </div>
</div>

<script>
(function() {
  var field = document.getElementById('inputField');
  var btn = document.getElementById('inputSendBtn');
  var page = '<%= typeof page !== "undefined" ? page : "general" %>';
  var contextId = '<%= typeof activeCollection !== "undefined" && activeCollection ? activeCollection._id : "" %>';

  function send() {
    var text = field.value.trim();
    if (!text) return;
    fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: text, context: page, contextId: contextId }),
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.chatId) window.location.href = '/chat/' + data.chatId;
    })
    .catch(function(err) { console.error('Chat error:', err); });
  }

  btn.addEventListener('click', send);
  field.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
  });
})();
</script>
