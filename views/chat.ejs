<%- include('partials/layout-start') %>

<!-- MathJax for chat -->
<script>
window.MathJax = {
  tex: { inlineMath: [['\\(', '\\)'], ['$', '$']], displayMath: [['\\[', '\\]'], ['$$', '$$']] },
  options: { skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre'] },
};
</script>
<script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>

<%
  var _chatCollection = (typeof chatCollection !== 'undefined') ? chatCollection : null;
  var _booksMap = (typeof booksMap !== 'undefined') ? booksMap : {};
%>
<div class="chat-view">
  <!-- Breadcrumb header: Collection / Chat ▾ -->
  <div class="chat-breadcrumb-bar">
    <div class="chat-breadcrumb">
      <% if (_chatCollection) { %>
        <a class="crumb crumb-collection" href="/collection/<%= _chatCollection._id %>"><%= _chatCollection.title %></a>
        <span class="crumb-sep">/</span>
      <% } else { %>
        <a class="crumb crumb-collection" href="/chats">Chats</a>
        <span class="crumb-sep">/</span>
      <% } %>
      <button class="crumb crumb-chat" id="chatCrumbBtn" type="button">
        <span class="crumb-chat-title" id="chatCrumbTitle"><%= chat.title || 'Untitled chat' %></span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </div>

    <div class="chat-crumb-menu" id="chatCrumbMenu" style="display:none;">
      <button class="action-item" data-action="star">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span id="starLabel"><%= chat.starred ? 'Unstar' : 'Star' %></span>
      </button>
      <button class="action-item" data-action="rename">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        Rename
      </button>
      <button class="action-item" data-action="change-project">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        Change project
      </button>
      <% if (chat.collectionId) { %>
      <button class="action-item" data-action="remove-project">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Remove from project
      </button>
      <% } %>
      <button class="action-item" data-action="copy-text">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Copy chat as text
      </button>
      <div class="action-divider"></div>
      <button class="action-item action-danger" data-action="delete">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        Delete
      </button>
    </div>
  </div>

  <% if (chat.highlightText) { %>
    <div class="chat-source-quote">
      <blockquote><%= chat.highlightText %></blockquote>
      <% if (chat.bookId) { %>
        <a href="/reader/<%= chat.bookId %>/page/<%= chat.pageNumber || 1 %>?highlight=<%= encodeURIComponent(chat.highlightText) %>" class="quote-source-link">
          Page <%= chat.pageNumber || 1 %> — open in reader
        </a>
      <% } %>
    </div>
  <% } %>

  <div class="chat-messages" id="chatMessages">
    <% (chat.messages || []).filter(function(m){ return m.kind !== 'tool'; }).forEach(function(msg) { %>
      <div class="chat-message chat-message-<%= msg.role %>">
        <div class="chat-message-label"><%= msg.role === 'user' ? 'You' : 'Claude' %></div>
        <div class="chat-message-content"><%= msg.role === 'user' ? msg.content : '' %></div>
        <div class="chat-message-actions">
          <button class="msg-action-btn msg-copy-btn" type="button" title="Copy message">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy</span>
          </button>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="chat-input-area">
    <div class="chat-input-wrap">
      <input type="text" class="chat-input" id="chatInput" placeholder="Send a message..." autocomplete="off">
      <!-- Graph tools toggle (Phase A). When active the next
           message is sent with useTools:true so Claude runs the
           graph-tool traversal loop (search_chunks, follow_edges,
           read_chunk, get_path, verify_quote) instead of a
           context-dump RAG reply. State is persisted in
           localStorage so the setting survives navigation. -->
      <button class="chat-tools-btn" id="chatToolsBtn" type="button" title="Toggle graph traversal tools for next message">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
        <span>tools</span>
      </button>
      <button class="chat-send-btn" id="chatSendBtn" title="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
(function() {
  var chatId = '<%= chat._id %>';
  var collectionIdAtLoad = '<%= chat.collectionId || "" %>';
  var booksMap = <%- JSON.stringify(_booksMap) %>;
  var messagesEl = document.getElementById('chatMessages');
  var input = document.getElementById('chatInput');
  var sendBtn = document.getElementById('chatSendBtn');
  var toolsBtn = document.getElementById('chatToolsBtn');
  var sending = false;
  var useTools = localStorage.getItem('gyde-use-tools') === '1';
  function syncToolsBtn() {
    if (!toolsBtn) return;
    toolsBtn.classList.toggle('active', useTools);
    toolsBtn.title = useTools
      ? 'Graph tools ON — Claude will traverse the edge graph for the next message. Click to turn off.'
      : 'Graph tools OFF — Claude will reply from static context. Click to enable traversal.';
  }
  if (toolsBtn) {
    toolsBtn.addEventListener('click', function() {
      useTools = !useTools;
      localStorage.setItem('gyde-use-tools', useTools ? '1' : '0');
      syncToolsBtn();
    });
    syncToolsBtn();
  }

  // Render existing assistant messages with markdown+MathJax
  var existingMsgs = <%- JSON.stringify((chat.messages || []).filter(m => m.role === 'assistant' && m.kind !== 'tool').map(m => m.content)) %>;
  var assistantDivs = messagesEl.querySelectorAll('.chat-message-assistant .chat-message-content');
  existingMsgs.forEach(function(text, i) {
    if (assistantDivs[i]) {
      assistantDivs[i].innerHTML = formatResponse(text);
    }
  });
  // Typeset existing messages
  if (window.MathJax && window.MathJax.startup) {
    MathJax.startup.promise.then(function() {
      MathJax.typesetPromise([messagesEl]).catch(function(){});
    });
  }

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }
  scrollToBottom();

  function addMessage(role, content) {
    var div = document.createElement('div');
    div.className = 'chat-message chat-message-' + role;
    div.innerHTML = '<div class="chat-message-label">' + (role === 'user' ? 'You' : 'Claude') + '</div>' +
                    '<div class="chat-message-content">' + content + '</div>' +
                    '<div class="chat-message-actions">' +
                      '<button class="msg-action-btn msg-copy-btn" type="button" title="Copy message">' +
                        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' +
                        '<span>Copy</span>' +
                      '</button>' +
                    '</div>';
    messagesEl.appendChild(div);
    scrollToBottom();
    return div;
  }

  // Single delegated handler for copy buttons across all messages.
  // Uses the rendered text (innerText) so users get the same content
  // they see, not the raw HTML with placeholders.
  document.addEventListener('click', function(e) {
    var btn = e.target.closest && e.target.closest('.msg-copy-btn');
    if (!btn) return;
    var msg = btn.closest('.chat-message');
    if (!msg) return;
    var content = msg.querySelector('.chat-message-content');
    if (!content) return;
    var text = content.innerText || content.textContent || '';
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(function() {
        var label = btn.querySelector('span');
        if (label) {
          var prev = label.textContent;
          label.textContent = 'Copied';
          setTimeout(function() { label.textContent = prev; }, 1200);
        }
      });
    }
  });

  function finishStream(contentDiv) {
    sending = false;
    input.disabled = false;
    sendBtn.disabled = false;
    input.focus();
    if (window.MathJax && MathJax.typesetPromise) {
      MathJax.typesetPromise([contentDiv]).catch(function(){});
    }
  }

  // Throttled MathJax typesetting during streaming. Re-typesets the
  // assistant message at most every 700 ms — frequent enough that
  // equations appear as the text grows but slow enough to avoid
  // flicker on every chunk. Final typeset happens in finishStream.
  function makeThrottledTypeset(contentDiv) {
    var pending = false;
    var lastRun = 0;
    var DELAY = 700;
    return function() {
      if (!window.MathJax || !MathJax.typesetPromise) return;
      var now = Date.now();
      if (now - lastRun >= DELAY && !pending) {
        lastRun = now;
        // Clear and retypeset just this message div
        if (MathJax.typesetClear) {
          try { MathJax.typesetClear([contentDiv]); } catch(e) {}
        }
        MathJax.typesetPromise([contentDiv]).catch(function(){});
        return;
      }
      if (pending) return;
      pending = true;
      setTimeout(function() {
        pending = false;
        lastRun = Date.now();
        if (MathJax.typesetClear) {
          try { MathJax.typesetClear([contentDiv]); } catch(e) {}
        }
        MathJax.typesetPromise([contentDiv]).catch(function(){});
      }, DELAY - (now - lastRun));
    };
  }

  function streamFrom(url, method, body) {
    var assistantDiv = addMessage('assistant', '<span class="typing-indicator">Thinking...</span>');
    var contentDiv = assistantDiv.querySelector('.chat-message-content');
    var typesetSoon = makeThrottledTypeset(contentDiv);
    var opts = { method: method, headers: { 'Content-Type': 'application/json' } };
    if (body) opts.body = JSON.stringify(body);

    fetch(url, opts).then(function(response) {
      var reader = response.body.getReader();
      var decoder = new TextDecoder();
      var fullText = '';
      var started = false;

      function read() {
        reader.read().then(function(result) {
          if (result.done) { finishStream(contentDiv); return; }
          var chunk = decoder.decode(result.value, { stream: true });
          chunk.split('\n').forEach(function(line) {
            line = line.trim();
            if (!line.startsWith('data: ')) return;
            try {
              var data = JSON.parse(line.substring(6));
              if (data.type === 'chunk') {
                if (!started) { contentDiv.innerHTML = ''; started = true; }
                fullText += data.text;
                contentDiv.innerHTML = formatResponse(fullText);
                scrollToBottom();
                typesetSoon();
              } else if (data.type === 'done' && data.text && data.text.indexOf('[[GYDE_ASK_GENERAL_KNOWLEDGE]]') !== -1) {
                var cleanContent = data.text.replace('[[GYDE_ASK_GENERAL_KNOWLEDGE]]', '');
                contentDiv.innerHTML = formatResponse(cleanContent);
                var btnRow = document.createElement('div');
                btnRow.className = 'gyde-confirm-row';
                btnRow.innerHTML = '<button class="gyde-btn-confirm-yes" onclick="gydeRequestGeneralKnowledge()">\u2713 Yes, answer from general knowledge</button>' +
                  '<button class="gyde-btn-confirm-no" onclick="this.closest(\'.gyde-confirm-row\').remove()">\u2717 No thanks</button>';
                contentDiv.appendChild(btnRow);
                scrollToBottom();
              } else if (data.type === 'error') {
                contentDiv.innerHTML = '<span style="color:#e55;">Error: ' + escapeHtml(data.error) + '</span>';
              }
            } catch(e) {}
          });
          read();
        });
      }
      read();
    }).catch(function() {
      contentDiv.innerHTML = '<span style="color:#e55;">Network error</span>';
      finishStream(contentDiv);
    });
  }

  function send(overrideOpts) {
    var text = (overrideOpts && overrideOpts.message) || input.value.trim();
    if (!text || sending) return;
    sending = true;
    if (!overrideOpts) {
      input.value = '';
      addMessage('user', escapeHtml(text));
    }
    input.disabled = true;
    sendBtn.disabled = true;
    var body = { message: text };
    if (overrideOpts && overrideOpts.generalKnowledge) body.generalKnowledge = true;
    var strictGrounding = localStorage.getItem('gyde-grounding-strict') !== '0';
    if (!strictGrounding) body.generalKnowledge = true;
    // Phase A graph-tool traversal — opt-in via the tools button.
    // When true the server runs streamWithTools() instead of the
    // plain chat stream.
    if (useTools && !body.generalKnowledge) body.useTools = true;
    streamFrom('/api/chat/' + chatId + '/message', 'POST', body);
  }

  function gydeRequestGeneralKnowledge() {
    document.querySelectorAll('.gyde-confirm-row').forEach(function(el) { el.remove(); });
    var lastUserMsgs = document.querySelectorAll('.chat-message[data-role="user"]');
    var lastUserMsg = lastUserMsgs.length ? (lastUserMsgs[lastUserMsgs.length - 1].querySelector('.message-content') || {}).innerText || '' : '';
    if (!lastUserMsg) return;
    addMessage('assistant', '<span style="opacity:0.5">Thinking...</span>');
    send({ message: lastUserMsg, generalKnowledge: true });
  }

  function escapeHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Replace [[cite bookId="X" page="N"]]quoted text[[/cite]] with placeholder tokens
  // BEFORE block splitting so the quote stays intact across newlines.
  var citationPlaceholders = [];
  function extractCitations(text) {
    citationPlaceholders = [];
    var re = /\[\[cite\s+bookId="([^"]+)"\s+page="([^"]+)"\]\]([\s\S]*?)\[\[\/cite\]\]/g;
    return text.replace(re, function(_, bookId, page, quote) {
      var idx = citationPlaceholders.length;
      citationPlaceholders.push({ bookId: bookId, page: page, quote: quote.trim() });
      return '\u0000CITE' + idx + '\u0000';
    });
  }
  function renderCitation(c) {
    var book = booksMap[c.bookId];
    var title = book ? book.title : 'Book';
    // Pass up to the first 60 words of the quote as the highlight param.
    // Earlier this was 20, which starved reader.js's PASS 2 cross-block
    // detection — 20 words almost always fits inside one <p>, so PASS 2
    // could never see a match spanning multiple blocks and extras stayed
    // at 0. 60 words is long enough to cover a heading + its first
    // sentence (which routinely crosses a block boundary) while still
    // short enough to keep the URL manageable. The prefix ladder inside
    // highlightQuoteIn already tries shorter slices (15/10/6/4/3) when
    // the full prefix doesn't match, so giving it more material never
    // hurts — it only ever enables more precise placements.
    var highlightWords = c.quote.split(/\s+/).filter(Boolean).slice(0, 60).join(' ');
    // sidebar=collapsed: when the reader opens inside the chat split view,
    // the TOC/nav sidebar should be hidden by default so the book fills the
    // available width. The reader's sidebar script honors this query param.
    var url = '/reader/' + encodeURIComponent(c.bookId) +
              '?page=' + encodeURIComponent(c.page) +
              '&sidebar=collapsed' +
              '&highlight=' + encodeURIComponent(highlightWords);
    var safeQuote = c.quote.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    var safeTitle = title.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    return '<a class="chat-cite" href="' + url + '" data-cite-url="' + url + '" title="Open ' + safeTitle + ' p.' + c.page + '">' +
           '<span class="chat-cite-quote">' + safeQuote + '</span>' +
           '<span class="chat-cite-source">— ' + safeTitle + ', p.' + c.page + '</span>' +
           '</a>';
  }
  function reinsertCitations(html) {
    return html.replace(/\u0000CITE(\d+)\u0000/g, function(_, i) {
      var c = citationPlaceholders[parseInt(i, 10)];
      return c ? renderCitation(c) : '';
    });
  }

  function formatResponse(rawText) {
    var text = extractCitations(rawText);
    // Split into blocks by double newline
    var blocks = text.split(/\n\n+/);
    var html = blocks.map(function(block) {
      block = block.trim();
      if (!block) return '';

      // Display math blocks: \[ ... \]
      if (/^\\\[/.test(block) && /\\\]$/.test(block)) {
        return '<div class="chat-math-display">' + block + '</div>';
      }

      // Headers: # / ## / ### — run processInline on the heading text so
      // **bold** and *italic* render (the AI uses italic for chunk type).
      if (/^###\s/.test(block)) return '<h3 class="chat-heading chat-heading-lg">' + processInline(block.replace(/^###\s+/, '')) + '</h3>';
      if (/^##\s/.test(block)) return '<h2 class="chat-heading chat-heading-xl">' + processInline(block.replace(/^##\s+/, '')) + '</h2>';
      if (/^#\s/.test(block)) return '<h2 class="chat-heading chat-heading-xl">' + processInline(block.replace(/^#\s+/, '')) + '</h2>';

      // Bullet lists
      var listLines = block.split('\n');
      if (listLines.every(function(l) { return /^\s*[-*]\s/.test(l) || !l.trim(); })) {
        var items = listLines
          .filter(function(l) { return l.trim(); })
          .map(function(l) { return '<li>' + processInline(l.replace(/^\s*[-*]\s+/, '')) + '</li>'; });
        return '<ul class="chat-list">' + items.join('') + '</ul>';
      }

      // Regular paragraph
      var lines = block.split('\n').map(function(l) { return processInline(l); });
      return '<p>' + lines.join('<br>') + '</p>';
    }).join('');

    return reinsertCitations(html);
  }

  function processInline(text) {
    // Escape HTML but preserve LaTeX
    var result = '';
    var i = 0;
    while (i < text.length) {
      // Preserve \( ... \) and \[ ... \]
      if (text[i] === '\\' && (text[i+1] === '(' || text[i+1] === '[')) {
        var close = text[i+1] === '(' ? '\\)' : '\\]';
        var end = text.indexOf(close, i+2);
        if (end !== -1) {
          result += text.substring(i, end + close.length);
          i = end + close.length;
          continue;
        }
      }
      // Escape special chars
      if (text[i] === '&') result += '&amp;';
      else if (text[i] === '<') result += '&lt;';
      else if (text[i] === '>') result += '&gt;';
      else result += text[i];
      i++;
    }
    // Bold — must run before italic so **text** wins over *text*
    result = result.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    // Italic — single asterisks around a run with no asterisks inside.
    // Escaped to avoid matching inside code blocks or equations.
    result = result.replace(/(^|[^*])\*([^*\n]+)\*(?!\*)/g, '$1<em>$2</em>');
    // Inline code
    result = result.replace(/`([^`]+)`/g, '<code>$1</code>');
    return result;
  }

  // Intercept citation link clicks: open the split reader panel, or update
  // it in place if already open. Never navigate away from the chat.
  messagesEl.addEventListener('click', function(e) {
    var link = e.target.closest && e.target.closest('a.chat-cite');
    if (!link) return;
    e.preventDefault();
    var url = link.getAttribute('data-cite-url') || link.getAttribute('href');
    if (!url) return;
    if (window.__isSplitReaderOpen && window.__isSplitReaderOpen()) {
      window.__updateSplitReader(url);
    } else if (window.__openSplitReader) {
      window.__openSplitReader(url);
    } else {
      window.location.href = url;
    }
  });

  sendBtn.addEventListener('click', send);
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
  });
  input.focus();

  // Auto-trigger if last message is user with no reply
  var lastMsg = messagesEl.querySelector('.chat-message:last-child');
  if (lastMsg && lastMsg.classList.contains('chat-message-user')) {
    sending = true;
    input.disabled = true;
    sendBtn.disabled = true;
    streamFrom('/api/chat/' + chatId + '/respond', 'POST');
  }

  // ─── BREADCRUMB DROPDOWN MENU ───────────────────────────────
  var crumbBtn = document.getElementById('chatCrumbBtn');
  var crumbMenu = document.getElementById('chatCrumbMenu');
  var crumbTitleEl = document.getElementById('chatCrumbTitle');

  function closeMenu() { crumbMenu.style.display = 'none'; }
  function openMenu() {
    var rect = crumbBtn.getBoundingClientRect();
    crumbMenu.style.left = rect.left + 'px';
    crumbMenu.style.top = (rect.bottom + 4) + 'px';
    crumbMenu.style.display = 'block';
  }
  crumbBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    if (crumbMenu.style.display === 'block') closeMenu(); else openMenu();
  });
  document.addEventListener('click', function(e) {
    if (!crumbMenu.contains(e.target) && e.target !== crumbBtn) closeMenu();
  });

  function patchChat(body) {
    return fetch('/api/chat/' + chatId, {
      method: 'PATCH', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    }).then(function(r) { return r.json(); });
  }

  crumbMenu.querySelectorAll('.action-item').forEach(function(item) {
    item.addEventListener('click', function() {
      var action = item.dataset.action;
      closeMenu();
      if (action === 'star') {
        var currentlyStarred = document.getElementById('starLabel').textContent === 'Unstar';
        patchChat({ starred: !currentlyStarred }).then(function() {
          document.getElementById('starLabel').textContent = currentlyStarred ? 'Star' : 'Unstar';
        });
      } else if (action === 'rename') {
        var current = crumbTitleEl.textContent;
        var nv = prompt('Rename chat:', current);
        if (nv && nv.trim() && nv.trim() !== current) {
          patchChat({ title: nv.trim() }).then(function() {
            crumbTitleEl.textContent = nv.trim();
          });
        }
      } else if (action === 'change-project') {
        showCollectionPickerForChat(function(targetId) {
          patchChat({ collectionId: targetId }).then(function() { location.reload(); });
        });
      } else if (action === 'remove-project') {
        if (!confirm('Remove this chat from its collection?')) return;
        patchChat({ collectionId: null }).then(function() { location.reload(); });
      } else if (action === 'copy-text') {
        copyChatAsPlainText();
      } else if (action === 'delete') {
        if (!confirm('Delete this chat permanently?')) return;
        fetch('/api/chat/' + chatId, { method: 'DELETE' }).then(function() {
          window.location.href = collectionIdAtLoad ? '/collection/' + collectionIdAtLoad : '/chats';
        });
      }
    });
  });

  function showCollectionPickerForChat(onPick) {
    fetch('/collections/api/all/list').then(function(r) { return r.json(); }).then(function(cols) {
      // Simple prompt-based picker as a fallback (no extra modal markup needed)
      var listText = cols.map(function(c, i) { return (i + 1) + '. ' + c.title; }).join('\n');
      var pick = prompt('Choose a collection by number:\n\n' + listText);
      var idx = parseInt(pick, 10) - 1;
      if (!isNaN(idx) && cols[idx]) onPick(cols[idx]._id);
    });
  }

  // Fetch the full chat message log and copy to clipboard as plain
  // text. Format: title at top, then each message as a
  // "===== ROLE (timestamp) =====" header followed by the body.
  // Used for sharing test results without copying message-by-message.
  function copyChatAsPlainText() {
    fetch('/chat/' + chatId + '/api/messages')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var msgs = (data && data.messages) || [];
        var title = (crumbTitleEl && crumbTitleEl.textContent) || 'Chat';
        var lines = ['# ' + title, ''];
        msgs.forEach(function(m) {
          var role = (m.role || 'unknown').toUpperCase();
          var ts = m.timestamp ? new Date(m.timestamp).toISOString() : '';
          lines.push('===== ' + role + (ts ? ' (' + ts + ')' : '') + ' =====');
          lines.push((m.content || '').toString());
          lines.push('');
        });
        var text = lines.join('\n');
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function() {
            alert('Copied ' + msgs.length + ' messages (' + text.length + ' chars) to clipboard.');
          }, function() { fallbackCopyText(text); });
        } else {
          fallbackCopyText(text);
        }
      })
      .catch(function(err) { alert('Failed to fetch chat: ' + (err.message || err)); });
  }

  function fallbackCopyText(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.top = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); alert('Copied (' + text.length + ' chars).'); }
    catch (e) { alert('Copy failed.'); }
    document.body.removeChild(ta);
  }
})();
</script>

