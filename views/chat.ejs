<%- include('partials/layout-start') %>

<div class="chat-view">
  <% if (chat.highlightText) { %>
    <div class="chat-source-quote">
      <blockquote><%= chat.highlightText %></blockquote>
    </div>
  <% } %>

  <div class="chat-messages" id="chatMessages">
    <% (chat.messages || []).forEach(function(msg) { %>
      <div class="chat-message chat-message-<%= msg.role %>">
        <div class="chat-message-label"><%= msg.role === 'user' ? 'You' : 'Claude' %></div>
        <div class="chat-message-content"><%- msg.role === 'assistant' ? msg.content.replace(/\n/g, '<br>') : msg.content %></div>
      </div>
    <% }); %>
  </div>

  <div class="chat-input-area">
    <div class="chat-input-wrap">
      <input type="text" class="chat-input" id="chatInput" placeholder="Send a message..." autocomplete="off">
      <button class="chat-send-btn" id="chatSendBtn" title="Send">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
(function() {
  var chatId = '<%= chat._id %>';
  var messages = document.getElementById('chatMessages');
  var input = document.getElementById('chatInput');
  var sendBtn = document.getElementById('chatSendBtn');
  var sending = false;

  function scrollToBottom() {
    messages.scrollTop = messages.scrollHeight;
  }
  scrollToBottom();

  function addMessage(role, content) {
    var div = document.createElement('div');
    div.className = 'chat-message chat-message-' + role;
    div.innerHTML = '<div class="chat-message-label">' + (role === 'user' ? 'You' : 'Claude') + '</div>' +
                    '<div class="chat-message-content">' + content + '</div>';
    messages.appendChild(div);
    scrollToBottom();
    return div;
  }

  function send() {
    var text = input.value.trim();
    if (!text || sending) return;
    sending = true;
    input.value = '';
    input.disabled = true;
    sendBtn.disabled = true;

    // Add user message immediately
    addMessage('user', escapeHtml(text));

    // Add assistant placeholder
    var assistantDiv = addMessage('assistant', '<span class="typing-indicator">Thinking...</span>');
    var contentDiv = assistantDiv.querySelector('.chat-message-content');

    // Stream response via SSE
    fetch('/api/chat/' + chatId + '/message', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: text }),
    }).then(function(response) {
      var reader = response.body.getReader();
      var decoder = new TextDecoder();
      var fullText = '';
      var started = false;

      function read() {
        reader.read().then(function(result) {
          if (result.done) {
            sending = false;
            input.disabled = false;
            sendBtn.disabled = false;
            input.focus();
            // Re-typeset MathJax if present
            if (window.MathJax && MathJax.typesetPromise) {
              MathJax.typesetPromise([contentDiv]).catch(function() {});
            }
            return;
          }

          var text = decoder.decode(result.value, { stream: true });
          var lines = text.split('\n');
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (line.startsWith('data: ')) {
              try {
                var data = JSON.parse(line.substring(6));
                if (data.type === 'chunk') {
                  if (!started) {
                    contentDiv.innerHTML = '';
                    started = true;
                  }
                  fullText += data.text;
                  contentDiv.innerHTML = formatResponse(fullText);
                  scrollToBottom();
                } else if (data.type === 'error') {
                  contentDiv.innerHTML = '<span style="color:#e55;">Error: ' + escapeHtml(data.error) + '</span>';
                }
              } catch (e) {}
            }
          }

          read();
        });
      }

      read();
    }).catch(function(err) {
      contentDiv.innerHTML = '<span style="color:#e55;">Network error</span>';
      sending = false;
      input.disabled = false;
      sendBtn.disabled = false;
    });
  }

  function escapeHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function formatResponse(text) {
    // Convert markdown-ish formatting
    var html = escapeHtml(text);
    // Bold: **text**
    html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    // Newlines to <br>
    html = html.replace(/\n/g, '<br>');
    // Restore LaTeX delimiters that got escaped
    html = html.replace(/\\&lt;/g, '\\<').replace(/\\&gt;/g, '\\>');
    html = html.replace(/&amp;/g, '&');
    // Restore \( \) \[ \] for MathJax
    html = html.replace(/\\?\\\(/g, '\\(').replace(/\\?\\\)/g, '\\)');
    html = html.replace(/\\?\\\[/g, '\\[').replace(/\\?\\\]/g, '\\]');
    return html;
  }

  sendBtn.addEventListener('click', send);
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
  });

  // Focus input on load
  input.focus();

  // Auto-trigger AI response if last message is from user with no reply
  var lastMsg = messages.querySelector('.chat-message:last-child');
  if (lastMsg && lastMsg.classList.contains('chat-message-user')) {
    // The chat was just created from the input bar — trigger AI response
    sending = true;
    input.disabled = true;
    sendBtn.disabled = true;

    var assistantDiv = addMessage('assistant', '<span class="typing-indicator">Thinking...</span>');
    var contentDiv = assistantDiv.querySelector('.chat-message-content');

    // Send empty message to trigger response for the already-saved user message
    fetch('/api/chat/' + chatId + '/respond', {
      method: 'POST',
    }).then(function(response) {
      var reader = response.body.getReader();
      var decoder = new TextDecoder();
      var fullText = '';
      var started = false;

      function readStream() {
        reader.read().then(function(result) {
          if (result.done) {
            sending = false;
            input.disabled = false;
            sendBtn.disabled = false;
            input.focus();
            if (window.MathJax && MathJax.typesetPromise) {
              MathJax.typesetPromise([contentDiv]).catch(function() {});
            }
            return;
          }
          var text = decoder.decode(result.value, { stream: true });
          var lines = text.split('\n');
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i].trim();
            if (line.startsWith('data: ')) {
              try {
                var data = JSON.parse(line.substring(6));
                if (data.type === 'chunk') {
                  if (!started) { contentDiv.innerHTML = ''; started = true; }
                  fullText += data.text;
                  contentDiv.innerHTML = formatResponse(fullText);
                  scrollToBottom();
                }
              } catch (e) {}
            }
          }
          readStream();
        });
      }
      readStream();
    }).catch(function() {
      contentDiv.innerHTML = '<span style="color:#e55;">Failed to get response</span>';
      sending = false;
      input.disabled = false;
      sendBtn.disabled = false;
    });
  }
})();
</script>

<style>
.chat-view {
  display: flex;
  flex-direction: column;
  height: 100%;
  max-width: 740px;
  margin: 0 auto;
  width: 100%;
  padding: 0 !important;
}

.chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.chat-message {
  max-width: 85%;
  font-size: 0.9rem;
  line-height: 1.65;
}

.chat-message-user {
  align-self: flex-end;
}

.chat-message-assistant {
  align-self: flex-start;
}

.chat-message-label {
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--app-text-muted);
  margin-bottom: 0.25rem;
}

.chat-message-user .chat-message-content {
  background: var(--app-accent);
  color: #fff;
  padding: 0.65rem 0.9rem;
  border-radius: 12px 12px 4px 12px;
}

.chat-message-assistant .chat-message-content {
  background: var(--app-surface);
  color: var(--app-text);
  padding: 0.65rem 0.9rem;
  border-radius: 12px 12px 12px 4px;
}

.chat-input-area {
  padding: 0.75rem 1rem 1rem;
  border-top: 1px solid var(--app-border);
  flex-shrink: 0;
}

.chat-input-wrap {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  background: var(--app-surface);
  border: 1px solid var(--app-border);
  border-radius: 12px;
  padding: 0.3rem 0.4rem;
  transition: border-color 0.15s ease;
}

.chat-input-wrap:focus-within {
  border-color: var(--app-accent);
}

.chat-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: var(--app-text);
  font-size: 0.875rem;
  padding: 0.4rem 0.5rem;
  font-family: inherit;
}

.chat-input::placeholder { color: var(--app-text-muted); }
.chat-input:disabled { opacity: 0.5; }

.chat-send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  border-radius: 8px;
  background: transparent;
  color: var(--app-text-muted);
  cursor: pointer;
  transition: all 0.12s ease;
}

.chat-send-btn:hover:not(:disabled) { background: var(--app-accent); color: #fff; }
.chat-send-btn:disabled { opacity: 0.3; cursor: default; }

.typing-indicator {
  color: var(--app-text-muted);
  font-style: italic;
}

.chat-source-quote {
  padding: 0.75rem 1rem;
  border-bottom: 1px solid var(--app-border);
  flex-shrink: 0;
}

.chat-source-quote blockquote {
  border-left: 3px solid var(--app-accent);
  padding-left: 0.7rem;
  color: var(--app-text-muted);
  font-style: italic;
  font-size: 0.8rem;
  margin: 0;
}
</style>

<%- include('partials/layout-end') %>
