<%- include('partials/layout-start') %>

<div class="collection-page">
  <div class="collection-topbar">
    <div>
      <h1>Library</h1>
      <p style="font-size:0.8rem;color:var(--app-text-muted);margin-top:0.15rem"><%= books.length %> book<%= books.length !== 1 ? 's' : '' %></p>
    </div>
    <div class="topbar-actions">
      <% if (activeStatus) { %>
        <a href="/library" class="btn btn-ghost">Clear filter</a>
      <% } %>
      <a href="/library?status=processing" class="btn btn-ghost <%= activeStatus === 'processing' ? 'active' : '' %>">Processing</a>
      <a href="/upload" class="btn btn-primary">Upload</a>
    </div>
  </div>

  <% if (books.length === 0) { %>
    <div class="empty-state">
      <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <h2>Your library is empty</h2>
      <p>Upload your first book or paper to get started.</p>
      <a href="/upload" class="btn btn-primary">Upload a PDF</a>
    </div>
  <% } else { %>
    <div class="book-grid collection-grid">
      <% books.forEach(function(book) { %>
        <a href="<%= book.status === 'ready' ? '/reader/' + book._id : '#' %>" class="book-card" data-book-id="<%= book._id %>" data-status="<%= book.status %>">
          <div class="book-cover">
            <div class="cover-placeholder">
              <div class="cover-spine"></div>
              <div class="cover-front">
                <span class="cover-title"><%= book.title || 'Untitled' %></span>
                <% if (book.author) { %><span class="cover-author"><%= book.author %></span><% } %>
              </div>
            </div>
            <% if (book.status === 'processing' || book.status === 'uploading') { %>
              <div class="processing-overlay"><div class="processing-spinner"></div><span class="processing-pct"><%= book.processingProgress %>%</span></div>
            <% } %>
          </div>
          <div class="book-info">
            <h3 class="book-title"><%= book.title || 'Untitled' %></h3>
            <% if (book.author) { %><p class="book-author"><%= book.author %></p><% } %>
            <% if (book.status === 'ready' && book.pageCount) { %>
              <span class="book-pages"><%= book.pageCount %> pages</span>
            <% } else if (book.status === 'processing') { %>
              <span class="book-pages" style="color:var(--app-accent)">Processing...</span>
            <% } %>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>

<script>
(function() {
  var cards = document.querySelectorAll('.book-card[data-status="processing"], .book-card[data-status="uploading"]');
  if (cards.length === 0) return;
  var poll = setInterval(async function() {
    try {
      var res = await fetch('/library/status');
      var books = await res.json();
      if (books.length === 0) { clearInterval(poll); location.reload(); return; }
      books.forEach(function(book) {
        var card = document.querySelector('.book-card[data-book-id="' + book._id + '"]');
        if (card) { var pct = card.querySelector('.processing-pct'); if (pct) pct.textContent = book.processingProgress + '%'; }
      });
    } catch (e) {}
  }, 2000);
})();
</script>

<%- include('partials/layout-end') %>
