<%- include('partials/layout-start') %>

<div class="collection-page-wrap">
  <div class="collection-page">
    <div class="collection-topbar">
      <h1 class="collection-title" contenteditable="true" data-id="<%= activeCollection ? activeCollection._id : '' %>"><%= activeCollection ? activeCollection.title : 'Collections' %></h1>
      <div class="topbar-actions">
        <a href="/upload<%= activeCollection ? '?collectionId=' + activeCollection._id : '' %>" class="btn btn-primary">Upload</a>
      </div>
    </div>

    <% if (books.length === 0) { %>
      <div class="empty-state">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <h2>No books yet</h2>
        <p>Upload a PDF to get started.</p>
        <a href="/upload" class="btn btn-primary">Upload a PDF</a>
      </div>
    <% } else { %>
      <div class="book-grid collection-grid">
        <% books.forEach(function(book) { %>
          <div class="book-card-wrap" data-book-id="<%= book._id %>">
            <a href="/reader/<%= book._id %>" class="book-card">
              <div class="book-cover">
                <% if (book.coverUrl) { %>
                  <img src="<%= book.coverUrl %>" alt="<%= book.title %>" class="cover-image">
                <% } else { %>
                  <div class="cover-placeholder">
                    <div class="cover-spine"></div>
                    <div class="cover-front">
                      <span class="cover-title"><%= book.title || 'Untitled' %></span>
                      <% if (book.author) { %>
                        <span class="cover-author"><%= book.author %></span>
                      <% } %>
                    </div>
                  </div>
                <% } %>
                <% if (book.status === 'processing') { %>
                  <div class="processing-overlay">
                    <div class="processing-spinner"></div>
                    <span class="processing-pct"><%= book.visionProgress || (book.processingProgress + '%') %></span>
                  </div>
                <% } %>
              </div>
              <div class="book-info">
                <h3 class="book-title"><%= book.title || 'Untitled' %></h3>
                <% if (book.author) { %>
                  <p class="book-author"><%= book.author %></p>
                <% } %>
                <% if (book.pageCount) { %>
                  <span class="book-pages"><%= book.pageCount %> pages</span>
                <% } %>
              </div>
            </a>
            <button class="book-actions-btn" data-book-id="<%= book._id %>" data-book-title="<%= (book.title || '').replace(/"/g, '&quot;') %>" title="Book actions">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="12" cy="19" r="2"/></svg>
            </button>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <% if (activeCollection) { %>
  <aside class="collection-right-panel">
    <div class="right-panel-section">
      <div class="right-panel-header">
        <h3>Instructions</h3>
        <button class="btn-icon" id="instructionsEditBtn" title="Edit">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </button>
      </div>
      <div class="instructions-display" id="instructionsDisplay"><%= activeCollection.instructions || 'No instructions set. Click edit to add AI context for this collection.' %></div>
      <textarea class="instructions-textarea" id="instructionsTextarea" style="display:none;" placeholder="AI context instructions for this collection..."><%= activeCollection.instructions || '' %></textarea>
      <div class="instructions-actions" id="instructionsActions" style="display:none;">
        <button class="btn btn-primary btn-sm" id="saveInstructionsBtn">Save</button>
        <button class="btn btn-secondary btn-sm" id="cancelInstructionsBtn">Cancel</button>
      </div>
    </div>

    <div class="right-panel-section">
      <div class="right-panel-header">
        <h3>Chats <span class="count-badge"><%= (activeCollection.chats || []).length %></span></h3>
      </div>
      <div class="right-panel-chats">
        <% if (!activeCollection.chats || activeCollection.chats.length === 0) { %>
          <p class="right-panel-empty">No chats yet. Use the input bar below.</p>
        <% } else { %>
          <% activeCollection.chats.forEach(function(chat) { %>
            <a href="/chat/<%= chat._id %>?from=collection&id=<%= activeCollection._id %>" class="right-panel-chat-item">
              <div class="chat-item-title"><%= chat.title || 'Untitled Chat' %></div>
              <div class="chat-item-preview"><%= chat.messages && chat.messages.length > 0 ? chat.messages[chat.messages.length-1].content.substring(0, 70) : '' %></div>
            </a>
          <% }); %>
        <% } %>
      </div>
    </div>
  </aside>
  <% } %>
</div>

<!-- Book Actions Menu (popup) -->
<div class="book-actions-menu" id="bookActionsMenu" style="display:none;">
  <button class="action-item" data-action="edit-cover">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
    Edit thumbnail
  </button>
  <button class="action-item" data-action="copy">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    Copy to collection
  </button>
  <button class="action-item" data-action="move">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
    Move to collection
  </button>
  <button class="action-item" data-action="remove">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Remove from collection
  </button>
  <div class="action-divider"></div>
  <button class="action-item action-danger" data-action="delete">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
    Delete from library
  </button>
</div>

<!-- Hidden file input for cover upload -->
<input type="file" id="coverFileInput" accept="image/*" style="display:none;">

<!-- Collection picker modal -->
<div class="modal-overlay" id="collectionPickerModal" style="display:none;">
  <div class="modal">
    <h2 id="pickerTitle">Select Collection</h2>
    <div class="collection-picker-list" id="collectionPickerList"></div>
    <div class="modal-actions">
      <button class="btn btn-secondary" onclick="document.getElementById('collectionPickerModal').style.display='none'">Cancel</button>
    </div>
  </div>
</div>

<script>
(function() {
  var titleEl = document.querySelector('.collection-title[contenteditable]');
  var activeCollectionId = '<%= activeCollection ? activeCollection._id : "" %>';

  // Inline title editing
  if (titleEl) {
    titleEl.addEventListener('blur', function() {
      var id = titleEl.dataset.id;
      if (!id) return;
      fetch('/collections/api/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title: titleEl.textContent.trim() }) });
    });
    titleEl.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') { e.preventDefault(); titleEl.blur(); }
    });
  }

  // Instructions edit
  var editBtn = document.getElementById('instructionsEditBtn');
  var displayEl = document.getElementById('instructionsDisplay');
  var textareaEl = document.getElementById('instructionsTextarea');
  var actionsEl = document.getElementById('instructionsActions');
  if (editBtn) {
    editBtn.addEventListener('click', function() {
      displayEl.style.display = 'none';
      textareaEl.style.display = '';
      actionsEl.style.display = '';
      textareaEl.focus();
    });
    document.getElementById('cancelInstructionsBtn').addEventListener('click', function() {
      displayEl.style.display = '';
      textareaEl.style.display = 'none';
      actionsEl.style.display = 'none';
    });
    document.getElementById('saveInstructionsBtn').addEventListener('click', function() {
      var text = textareaEl.value;
      fetch('/collections/api/' + activeCollectionId, {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ instructions: text }),
      }).then(function() {
        displayEl.textContent = text || 'No instructions set. Click edit to add AI context for this collection.';
        displayEl.style.display = '';
        textareaEl.style.display = 'none';
        actionsEl.style.display = 'none';
      });
    });
  }

  // ─── BOOK ACTIONS MENU ──────────────────────────────────────
  var menu = document.getElementById('bookActionsMenu');
  var currentBookId = null;
  var currentBookTitle = null;

  document.querySelectorAll('.book-actions-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      currentBookId = btn.dataset.bookId;
      currentBookTitle = btn.dataset.bookTitle;
      var rect = btn.getBoundingClientRect();
      menu.style.display = 'block';
      menu.style.left = (rect.right - 180) + 'px';
      menu.style.top = (rect.bottom + 4) + 'px';
    });
  });

  document.addEventListener('click', function(e) {
    if (!menu.contains(e.target) && !e.target.closest('.book-actions-btn')) {
      menu.style.display = 'none';
    }
  });

  // Action handlers
  menu.querySelectorAll('.action-item').forEach(function(item) {
    item.addEventListener('click', function(e) {
      e.stopPropagation();
      var action = item.dataset.action;
      menu.style.display = 'none';

      if (action === 'edit-cover') {
        document.getElementById('coverFileInput').click();
      } else if (action === 'copy') {
        showCollectionPicker('Copy to collection', function(targetId) {
          fetch('/api/books/' + currentBookId + '/copy', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ targetCollectionId: targetId }),
          }).then(function() { alert('Book copied'); });
        });
      } else if (action === 'move') {
        showCollectionPicker('Move to collection', function(targetId) {
          fetch('/api/books/' + currentBookId + '/move', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fromCollectionId: activeCollectionId, targetCollectionId: targetId }),
          }).then(function() { location.reload(); });
        });
      } else if (action === 'remove') {
        if (!confirm('Remove "' + currentBookTitle + '" from this collection? (The book stays in your library.)')) return;
        fetch('/collections/api/' + activeCollectionId + '/books', {
          method: 'DELETE', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ bookId: currentBookId }),
        }).then(function() { location.reload(); });
      } else if (action === 'delete') {
        if (!confirm('PERMANENTLY DELETE "' + currentBookTitle + '" from your entire library? This removes the book, all its pages, highlights, notes, and chats.')) return;
        fetch('/api/books/' + currentBookId, { method: 'DELETE' }).then(function() { location.reload(); });
      }
    });
  });

  // Cover upload
  document.getElementById('coverFileInput').addEventListener('change', function(e) {
    var file = e.target.files[0];
    if (!file || !currentBookId) return;
    var formData = new FormData();
    formData.append('cover', file);
    fetch('/api/books/' + currentBookId + '/cover', { method: 'POST', body: formData })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.ok) location.reload();
        else alert('Upload failed: ' + (data.error || 'unknown'));
      });
  });

  // Collection picker
  function showCollectionPicker(title, onPick) {
    var modal = document.getElementById('collectionPickerModal');
    document.getElementById('pickerTitle').textContent = title;
    var list = document.getElementById('collectionPickerList');
    list.innerHTML = 'Loading...';
    modal.style.display = '';

    fetch('/collections/api/all/list').then(function(r) { return r.json(); }).then(function(cols) {
      list.innerHTML = '';
      cols.filter(function(c) { return c._id !== activeCollectionId; }).forEach(function(col) {
        var btn = document.createElement('button');
        btn.className = 'collection-picker-item';
        btn.innerHTML = '<span class="col-dot" style="background:' + (col.color || '#2d5a7b') + '"></span>' + col.title;
        btn.addEventListener('click', function() {
          modal.style.display = 'none';
          onPick(col._id);
        });
        list.appendChild(btn);
      });
    });
  }
})();
</script>

<%- include('partials/layout-end') %>
