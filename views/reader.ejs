<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Gyde Reader</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/reader.css">
</head>
<body class="app-body">

  <!-- Single app sidebar with tabs when in reader -->
  <aside class="app-sidebar" id="appSidebar">
    <div class="sidebar-top">
      <button class="sidebar-collapse-btn" id="sidebarCollapseBtn" title="Toggle sidebar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <button class="sidebar-mode-btn" id="sidebarModeBtn">Projects</button>
    </div>

    <!-- Tab panel: Contents (TOC) -->
    <div class="sidebar-tab-panel" id="panelContents">
      <nav class="sidebar-nav">
        <% if (toc.length === 0) { %>
          <div class="sidebar-empty" style="padding:0.5rem 0.75rem;">
            <div class="sidebar-pages">
              <% for (let i = 1; i <= (book.pageCount || 1); i++) { %>
                <a href="#" class="page-link <%= i === pageNumber ? 'active' : '' %>" data-page="<%= i %>">Page <%= i %></a>
              <% } %>
            </div>
          </div>
        <% } else { %>
          <ul class="toc-list">
            <% toc.forEach(function(chapter) { %>
              <li class="toc-chapter">
                <a href="#" class="toc-link chapter-link <%= chapter.page === pageNumber ? 'active' : '' %>" data-page="<%= chapter.page %>">
                  <span class="toc-title"><%= chapter.title %></span>
                  <span class="toc-page"><%= chapter.page %></span>
                </a>
                <% if (chapter.sections && chapter.sections.length > 0) { %>
                  <ul class="toc-sections">
                    <% chapter.sections.forEach(function(section) { %>
                      <li><a href="#" class="toc-link section-link <%= section.page === pageNumber ? 'active' : '' %>" data-page="<%= section.page %>"><span class="toc-title"><%= section.title %></span><span class="toc-page"><%= section.page %></span></a></li>
                    <% }); %>
                  </ul>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } %>
      </nav>
    </div>

    <!-- Tab panel: Collections/Chats nav -->
    <div class="sidebar-tab-panel" id="panelNav" style="display:none;">
      <nav class="sidebar-nav-main" style="padding:0 0.4rem;">
        <a href="/chats" class="sidebar-nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span class="nav-label">All Chats</span>
        </a>
        <a href="/files" class="sidebar-nav-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span class="nav-label">All Files</span>
        </a>
      </nav>
      <div class="sidebar-divider"></div>
      <div class="sidebar-context" style="padding:0 0.4rem;">
        <div class="sidebar-section-label"><span class="nav-label">Projects</span></div>
        <% (collections || []).filter(function(c) { return c.title !== 'All Books'; }).forEach(function(col) { %>
          <a href="/collection/<%= col._id %>" class="sidebar-context-item">
            <span class="col-dot" style="background:<%= col.color %>"></span>
            <span class="nav-label"><%= col.title %></span>
          </a>
        <% }); %>
        <button class="sidebar-new-btn" id="sidebarNewCollectionBtn" type="button">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <span class="nav-label">New Project</span>
        </button>
      </div>
    </div>

    <!-- New Project modal (mirrors the one in views/partials/sidebar.ejs) -->
    <div class="modal-overlay" id="newCollectionModal" style="display:none;">
      <div class="modal">
        <h2>New Project</h2>
        <input type="text" id="newCollectionTitle" class="modal-input" placeholder="Project name" maxlength="120" />
        <textarea id="newCollectionInstructions" class="modal-input" placeholder="AI instructions (optional)" rows="3"></textarea>
        <div class="modal-actions">
          <button class="btn btn-secondary" id="newCollectionCancelBtn" type="button">Cancel</button>
          <button class="btn btn-primary" id="newCollectionCreateBtn" type="button">Create</button>
        </div>
      </div>
    </div>

    <div class="sidebar-bottom">
      <div class="sidebar-user">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span class="nav-label">Jonathan Valenzuela</span>
      </div>
    </div>
  </aside>

  <div class="reader-wrapper">
    <header class="reader-header">
      <div class="reader-header-left">
        <button class="reader-btn page-turn-btn" id="headerPrevBtn" title="Previous page">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <span class="reader-page-indicator" id="pageIndicator">
          Page <span id="currentPageNum"><%= pageNumber %></span> of <span id="totalPages"><%= book.pageCount || '?' %></span>
        </span>
        <span class="reader-book-title"><%= book.title || 'Untitled' %></span>
      </div>
      <div class="reader-header-center"></div>
      <div class="reader-header-right">
        <!-- View settings menu (Format × Layout × Ask AI) — replaces
             the old Pages/Scroll/PDF/Chunks row and the old
             toggle-chat-panel button. Apple-Preview-style dropdown. -->
        <div class="view-settings-wrap">
          <button class="reader-btn view-settings-btn" id="viewSettingsBtn" title="View settings" aria-haspopup="true" aria-expanded="false">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="9" y1="4" x2="9" y2="20"/></svg>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-left:3px;"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="view-settings-menu" id="viewSettingsMenu" style="display:none;" role="menu">
            <div class="vsm-section">
              <div class="vsm-label">Format</div>
              <div class="vsm-options" data-axis="format">
                <button type="button" class="vsm-btn" data-value="html">HTML</button>
                <button type="button" class="vsm-btn" data-value="pdf">PDF</button>
                <button type="button" class="vsm-btn" data-value="metadata" title="Metadata layer — chunks, spans, tags, edges">Metadata</button>
              </div>
            </div>
            <div class="vsm-divider"></div>
            <div class="vsm-section">
              <div class="vsm-label">Layout</div>
              <div class="vsm-options" data-axis="layout">
                <button type="button" class="vsm-btn" data-value="pages">Pages</button>
                <button type="button" class="vsm-btn" data-value="scroll">Scroll</button>
              </div>
            </div>
            <div class="vsm-divider"></div>
            <div class="vsm-section">
              <div class="vsm-label">Ask AI</div>
              <div class="vsm-options" data-axis="askai">
                <button type="button" class="vsm-btn" data-value="off">Off</button>
                <button type="button" class="vsm-btn" data-value="on">On</button>
              </div>
            </div>
          </div>
        </div>
        <!-- Legacy splitToggleBtn kept hidden so split-chat.js still
             wires without errors. Toggled programmatically by the
             Ask AI section of the view settings menu. -->
        <button class="reader-btn" id="splitToggleBtn" title="Toggle chat panel" style="display:none;" aria-hidden="true"></button>
        <button class="reader-btn page-turn-btn" id="headerNextBtn" title="Next page">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    </header>

    <div class="reader-body-row">
    <main class="reader-main" id="readerMain">
      <!-- Pages mode -->
      <div class="reader-content" id="readerContent">
        <% if (page && page.htmlContent) { %>
          <%- page.htmlContent %>
        <% } else if (page && (page.rawTextLegacy || page.rawText)) { %>
          <%
            // Vision processing hasn't completed yet for this page.
            // Render the pdf-parse text as paragraphs so the user
            // can read and interact with the page immediately —
            // upload no longer blocks reader interaction. The page
            // will be silently upgraded to vision-rendered HTML
            // (with proper LaTeX) once vision finishes.
            var fallbackText = page.rawTextLegacy || page.rawText || '';
            var paras = fallbackText.split(/\n\n+/).filter(function(p) { return p.trim(); });
          %>
          <div class="page-content vision-pending" data-page-number="<%= pageNumber %>">
            <div class="vision-pending-banner">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <span>Showing fast text extraction. Vision processing in progress — equations and figures will appear as soon as they finish.</span>
            </div>
            <% paras.forEach(function(p) { %>
              <p><%= p.replace(/\s+/g, ' ').trim() %></p>
            <% }); %>
          </div>
        <% } else { %>
          <div class="page-content"><p class="empty-page">No content available for this page yet.</p></div>
        <% } %>
      </div>

      <!-- Scroll mode -->
      <div class="reader-scroll-content" id="readerScrollContent" style="display:none;"></div>

      <!-- PDF + Pages (single page image) -->
      <div class="reader-original" id="readerOriginal" style="display:none;">
        <img id="originalPageImg" src="/images/<%= book._id %>/page-<%= pageNumber %>.png" alt="Page original">
      </div>

      <!-- PDF + Scroll (stacked page images, lazy-loaded) -->
      <div class="reader-pdf-scroll" id="readerPdfScroll" style="display:none;"></div>

      <!-- Metadata + Scroll (chunks-view for all pages) -->
      <div class="reader-chunks-content" id="readerChunksContent" style="display:none;"></div>

      <!-- Metadata + Pages (chunks-view for current page only) -->
      <div class="reader-chunks-single" id="readerChunksSingle" style="display:none;"></div>

      <!-- Page jump (hidden, used by keyboard nav) -->
      <input type="hidden" id="pageJump" value="<%= pageNumber %>">
    </main>

    <!-- Draggable divider -->
    <div class="split-divider" id="splitDivider" style="display:none;"></div>

    <!-- Split chat panel -->
    <div class="split-chat-panel" id="splitChatPanel" style="display:none;">
      <div class="split-chat-header">
        <span class="split-chat-title">Chat</span>
        <button class="reader-btn" id="splitCloseBtn" title="Close chat panel">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="split-chat-quote" id="splitChatQuote" style="display:none;">
        <blockquote id="splitQuoteText"></blockquote>
      </div>
      <div class="split-chat-messages" id="splitChatMessages"></div>
      <div class="split-chat-input">
        <div class="chat-input-wrap">
          <input type="text" class="chat-input" id="splitChatInput" placeholder="Ask about this text..." autocomplete="off">
          <button class="chat-send-btn" id="splitChatSendBtn" title="Send">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          </button>
        </div>
      </div>
    </div>

    </div><!-- .reader-body-row -->

    <!-- Input bar (hidden when split is open) -->
    <div class="input-bar">
      <div class="input-bar-inner">
        <button class="input-attach-btn" disabled title="Attach (coming soon)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
        </button>
        <input type="text" class="input-field" id="readerInputField" placeholder="Ask about this page..." autocomplete="off">
        <button class="input-send-btn" id="readerInputSendBtn" title="Send">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </div>
  </div>

  <script>
    window.__READER__ = {
      bookId: '<%= book._id %>',
      bookTitle: '<%= (book.title || "").replace(/'/g, "\\'") %>',
      currentPage: <%= pageNumber %>,
      totalPages: <%= book.pageCount || 1 %>,
    };
  </script>

  <script>
    window.MathJax = {
      tex: { inlineMath: [['\\(', '\\)'], ['$', '$']], displayMath: [['\\[', '\\]'], ['$$', '$$']] },
      options: { skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre'] },
      startup: {
        pageReady: function () {
          return MathJax.startup.defaultPageReady().then(function() {
            document.querySelectorAll('mjx-container[data-mjx-error]').forEach(function(el) {
              var fb = document.createElement('span');
              fb.className = 'mathjax-fallback';
              fb.textContent = '[equation \u2014 view original]';
              fb.style.cssText = 'color:var(--r-text-muted);cursor:pointer;font-style:italic;font-size:0.85em;';
              fb.addEventListener('click', function() { document.getElementById('modePdfBtn')?.click(); });
              el.replaceWith(fb);
            });
          });
        }
      }
    };
  </script>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>
  <script src="/js/reader.js"></script>
  <script src="/js/highlights.js"></script>
  <script src="/js/split-chat.js"></script>
  <script src="/js/notes-panel.js"></script>
  <script src="/js/metadata-panel.js"></script>
  <script src="/js/chunks-view.js"></script>
  <script src="/js/chat-split-reader.js"></script>

  <!-- Sidebar toggle + tabs -->
  <script>
  (function() {
    var sidebar = document.getElementById('appSidebar');
    var btn = document.getElementById('sidebarCollapseBtn');
    var key = 'gyde-sidebar-state';
    // Honor ?sidebar=collapsed so when the reader is embedded inside the
    // chat split view it starts with the TOC hidden (the user can still
    // open it manually via the hamburger).
    var forceCollapsed = /[?&]sidebar=collapsed(&|$)/.test(window.location.search);
    // Auto-collapse on narrow viewports (Z Fold cover, phones). The
    // sidebar is 240px wide; on a ~400px viewport it leaves only ~160px
    // for the reader which is unreadable. User can still open it via
    // the hamburger. Threshold matches the reader.css responsive
    // breakpoints.
    var narrowViewport = window.matchMedia && window.matchMedia('(max-width: 900px)').matches;
    if (forceCollapsed || narrowViewport || localStorage.getItem(key) === 'collapsed') {
      sidebar.classList.add('collapsed');
    }
    btn.addEventListener('click', function() {
      sidebar.classList.toggle('collapsed');
      localStorage.setItem(key, sidebar.classList.contains('collapsed') ? 'collapsed' : 'open');
    });

    // Mode toggle: Contents / Projects
    var modeBtn = document.getElementById('sidebarModeBtn');
    var panelContents = document.getElementById('panelContents');
    var panelNav = document.getElementById('panelNav');
    var sidebarMode = 'contents'; // default to contents in reader

    modeBtn.addEventListener('click', function() {
      if (sidebarMode === 'contents') {
        sidebarMode = 'nav';
        panelContents.style.display = 'none';
        panelNav.style.display = '';
        modeBtn.textContent = 'Contents';
      } else {
        sidebarMode = 'contents';
        panelContents.style.display = '';
        panelNav.style.display = 'none';
        modeBtn.textContent = 'Projects';
      }
    });
  })();
  </script>

  <!-- New Project modal wiring (same endpoint as the main sidebar partial) -->
  <script>
  (function() {
    var btn = document.getElementById('sidebarNewCollectionBtn');
    var modal = document.getElementById('newCollectionModal');
    if (!btn || !modal) return;
    var titleInput = document.getElementById('newCollectionTitle');
    var instrInput = document.getElementById('newCollectionInstructions');
    var cancelBtn = document.getElementById('newCollectionCancelBtn');
    var createBtn = document.getElementById('newCollectionCreateBtn');
    function open() {
      titleInput.value = '';
      instrInput.value = '';
      modal.style.display = '';
      setTimeout(function() { titleInput.focus(); }, 10);
    }
    function close() { modal.style.display = 'none'; }
    btn.addEventListener('click', function(e) { e.preventDefault(); open(); });
    cancelBtn.addEventListener('click', close);
    modal.addEventListener('click', function(e) { if (e.target === modal) close(); });
    function submit() {
      var title = (titleInput.value || '').trim();
      if (!title) { titleInput.focus(); return; }
      createBtn.disabled = true;
      fetch('/collections/api', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title: title, instructions: instrInput.value || '' }),
      }).then(function(r) { return r.json(); }).then(function(col) {
        createBtn.disabled = false;
        if (col && col._id) {
          window.location.href = '/collection/' + col._id;
        } else {
          alert('Failed to create project');
        }
      }).catch(function() {
        createBtn.disabled = false;
        alert('Network error creating project');
      });
    }
    createBtn.addEventListener('click', submit);
    titleInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') { e.preventDefault(); submit(); }
      if (e.key === 'Escape') close();
    });
  })();
  </script>

  <!-- Reader input bar -->
  <script>
  (function() {
    var R = window.__READER__;
    var field = document.getElementById('readerInputField');
    var btn = document.getElementById('readerInputSendBtn');
    function send() {
      var text = field.value.trim();
      if (!text) return;
      fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, context: 'reader', bookId: R.bookId, bookTitle: R.bookTitle, pageNumber: R.currentPage }),
      }).then(function(r) { return r.json(); }).then(function(d) { if (d.chatId) window.location.href = '/chat/' + d.chatId; });
    }
    btn.addEventListener('click', send);
    field.addEventListener('keydown', function(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); } });
  })();
  </script>
</body>
</html>
