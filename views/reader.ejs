<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Gyde Reader</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="stylesheet" href="/css/reader.css">
</head>
<body class="app-body">
  <% var page = 'reader'; %>
  <%- include('partials/sidebar') %>

  <div class="reader-wrapper">
    <header class="reader-header">
      <div class="reader-header-left">
        <button class="reader-btn" id="sidebarSwapBtn" title="Toggle between app sidebar and contents">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <span class="reader-book-title"><%= book.title || 'Untitled' %></span>
      </div>
      <div class="reader-header-center">
        <div class="reader-mode-toggle" id="modeToggle">
          <button class="mode-btn active" id="modePagesBtn" data-mode="pages">Pages</button>
          <button class="mode-btn" id="modeScrollBtn" data-mode="scroll">Scroll</button>
        </div>
        <span class="reader-page-indicator" id="pageIndicator">
          Page <span id="currentPageNum"><%= pageNumber %></span> of <span id="totalPages"><%= book.pageCount || '?' %></span>
        </span>
        <button class="reader-btn view-original-toggle" id="viewOriginalToggle" title="View original page image">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </button>
      </div>
      <div class="reader-header-right">
        <button class="reader-btn theme-toggle" id="themeToggle" title="Toggle dark mode">
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </header>

    <div class="reader-layout">
      <aside class="reader-sidebar" id="readerSidebar">
        <div class="sidebar-header"><h2>Contents</h2></div>
        <nav class="sidebar-nav">
          <% if (toc.length === 0) { %>
            <div class="sidebar-empty">
              <p>No chapters detected</p>
              <div class="sidebar-pages">
                <% for (let i = 1; i <= (book.pageCount || 1); i++) { %>
                  <a href="#" class="page-link <%= i === pageNumber ? 'active' : '' %>" data-page="<%= i %>">Page <%= i %></a>
                <% } %>
              </div>
            </div>
          <% } else { %>
            <ul class="toc-list">
              <% toc.forEach(function(chapter) { %>
                <li class="toc-chapter">
                  <a href="#" class="toc-link chapter-link <%= chapter.page === pageNumber ? 'active' : '' %>" data-page="<%= chapter.page %>">
                    <span class="toc-title"><%= chapter.title %></span>
                    <span class="toc-page"><%= chapter.page %></span>
                  </a>
                  <% if (chapter.sections && chapter.sections.length > 0) { %>
                    <ul class="toc-sections">
                      <% chapter.sections.forEach(function(section) { %>
                        <li><a href="#" class="toc-link section-link <%= section.page === pageNumber ? 'active' : '' %>" data-page="<%= section.page %>"><span class="toc-title"><%= section.title %></span><span class="toc-page"><%= section.page %></span></a></li>
                      <% }); %>
                    </ul>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </nav>
      </aside>

      <main class="reader-main" id="readerMain">
        <!-- Pages mode: single page -->
        <div class="reader-content" id="readerContent">
          <% if (page && page.htmlContent) { %>
            <%- page.htmlContent %>
          <% } else { %>
            <div class="page-content"><p class="empty-page">No content available for this page.</p></div>
          <% } %>
        </div>

        <!-- Scroll mode: all pages (loaded dynamically) -->
        <div class="reader-scroll-content" id="readerScrollContent" style="display:none;"></div>

        <!-- Original page image view -->
        <div class="reader-original" id="readerOriginal" style="display:none;">
          <img id="originalPageImg" src="/images/<%= book._id %>/page-<%= pageNumber %>.png" alt="Page original">
        </div>

        <!-- Page navigation (pages mode only) -->
        <div class="reader-page-nav" id="readerPageNav">
          <button class="page-nav-btn prev-btn" id="prevBtn" <%= pageNumber <= 1 ? 'disabled' : '' %>>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            Previous
          </button>
          <div class="page-nav-center">
            <input type="number" class="page-jump" id="pageJump" value="<%= pageNumber %>" min="1" max="<%= book.pageCount || 1 %>">
          </div>
          <button class="page-nav-btn next-btn" id="nextBtn" <%= pageNumber >= (book.pageCount || 1) ? 'disabled' : '' %>>
            Next
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </main>
    </div>

    <!-- Input bar for reader context -->
    <div class="input-bar" id="readerInputBar">
      <div class="input-bar-inner">
        <button class="input-attach-btn" disabled title="Attach files (coming soon)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
        </button>
        <input type="text" class="input-field" id="readerInputField" placeholder="Ask about this page..." autocomplete="off">
        <button class="input-send-btn" id="readerInputSendBtn" title="Send">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </div>
  </div>

  <script>
    window.__READER__ = {
      bookId: '<%= book._id %>',
      bookTitle: '<%= (book.title || "").replace(/'/g, "\\'") %>',
      currentPage: <%= pageNumber %>,
      totalPages: <%= book.pageCount || 1 %>,
    };
  </script>

  <script>
    window.MathJax = {
      tex: { inlineMath: [['\\(', '\\)'], ['$', '$']], displayMath: [['\\[', '\\]'], ['$$', '$$']] },
      options: { skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre'] },
      startup: {
        pageReady: function () {
          return MathJax.startup.defaultPageReady().then(function() {
            document.querySelectorAll('mjx-container[data-mjx-error]').forEach(function(el) {
              var fb = document.createElement('span');
              fb.className = 'mathjax-fallback';
              fb.textContent = '[equation \u2014 view original page]';
              fb.addEventListener('click', function() { document.getElementById('viewOriginalToggle')?.click(); });
              el.replaceWith(fb);
            });
          });
        }
      }
    };
  </script>
  <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>
  <script src="/js/reader.js"></script>

  <!-- Sidebar swap: hamburger cycles between app sidebar, TOC sidebar, and none -->
  <script>
  (function() {
    var appSidebar = document.getElementById('appSidebar');
    var tocSidebar = document.getElementById('readerSidebar');
    var swapBtn = document.getElementById('sidebarSwapBtn');
    var collapseBtn = document.getElementById('sidebarCollapseBtn');
    // States: 'toc' (default in reader), 'app', 'none'
    var state = localStorage.getItem('gyde-reader-sidebar-state') || 'toc';

    function apply() {
      if (state === 'app') {
        appSidebar.classList.remove('collapsed');
        tocSidebar.classList.add('collapsed');
      } else if (state === 'toc') {
        appSidebar.classList.add('collapsed');
        tocSidebar.classList.remove('collapsed');
      } else {
        appSidebar.classList.add('collapsed');
        tocSidebar.classList.add('collapsed');
      }
    }

    function cycle() {
      if (state === 'toc') state = 'app';
      else if (state === 'app') state = 'none';
      else state = 'toc';
      localStorage.setItem('gyde-reader-sidebar-state', state);
      apply();
    }

    apply();
    swapBtn.addEventListener('click', cycle);
    // The app sidebar's own collapse button also cycles
    collapseBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      cycle();
    });
  })();
  </script>

  <!-- Reader input bar (context-aware) -->
  <script>
  (function() {
    var R = window.__READER__;
    var field = document.getElementById('readerInputField');
    var btn = document.getElementById('readerInputSendBtn');
    function send() {
      var text = field.value.trim();
      if (!text) return;
      fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: text,
          context: 'reader',
          bookId: R.bookId,
          bookTitle: R.bookTitle,
          pageNumber: R.currentPage,
        }),
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.chatId) window.location.href = '/chat/' + data.chatId;
      });
    }
    btn.addEventListener('click', send);
    field.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
    });
  })();
  </script>
</body>
</html>
